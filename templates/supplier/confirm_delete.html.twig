{% extends 'base.html.twig' %}

{% block title %}Suppliers Index{% endblock %}

{% block main %}
    
    <h1>Supplier info</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Postal Code</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ supplier.id }}</td>
                <td>{{ supplier.name }}</td>
                <td>{{ supplier.phone }}</td>
                <td>{{ supplier.postalCode }}</td>
                <td>{{ supplier.address }}</td>
            </tr>
        </tbody>
    </table>

    <div class="float-end ms-2 p-1 mb-2 bg-danger text-danger bg-opacity-10 border border-danger border-opacity-50 rounded">
        {{ include('supplier/_delete_form.html.twig') }}
    </div>

{% endblock %}
