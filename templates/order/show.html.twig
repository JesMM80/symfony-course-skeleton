{% extends 'base.html.twig' %}

{% block title %}Order{% endblock %}

{% block body %}
    <h1>Order</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>Total</th>
            </tr>
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.status }}</td>
                <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ order.total }}</td>
            </tr>
            <tr>
                <th>Product</th>
                <th>Units</th>
                <th>Price</th>
                <th>Current Price</th>
                <th>Subtotal</th>
                <th>Delete</th>
            </tr>

            {% for item in order.items %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.unitPrice }}</td>
                <td>{{ item.product.price }}</td>
                <td>{{ item.subtotal }}</td>
                <td>
                    {# <a href="{{ path('app_order_item_delete', {'orderId': order.id, 'itemId': item.id}) }}">Delete</a> #}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_order_index') }}">back to list</a>

    <a href="{{ path('app_order_edit', {'id': order.id}) }}">edit</a>

    {{ include('order/_delete_form.html.twig') }}
{% endblock %}
