{% extends 'base.html.twig' %}

{% block title %}New Order{% endblock %}

{% block body %}
    <h1>Create new Order</h1>

    {{ form_start(form) }}

    <h3>Productos</h3>

    {% for itemForm in form.items %}
        <div class="order-item">
            {{ form_row(itemForm.product) }}
            {{ form_row(itemForm.quantity) }}
        </div>
    {% endfor %}

    <button class="btn btn-primary">Guardar pedido</button>

    {{ form_end(form) }}

    <a href="{{ path('app_order_index') }}">back to list</a>
{% endblock %}
